rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Room data: no publicly readable or writable paths without login.
    match /dinguz_rooms/{roomCode} {
      function signedIn() { return request.auth != null; }
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.memberUids;
      }
      // A player may join a waiting room, but may only add their player entry
      // and member UID. Existing participants control the in-room state.
      function isJoin() {
        return signedIn()
          && resource.data.status == 'waiting'
          && !(request.auth.uid in resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['players', 'memberUids', 'rev']);
      }
      allow get, list: if signedIn();
      allow create: if signedIn()
        && request.resource.data.host == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];
      allow update: if isMember() || isJoin();
      allow delete: if signedIn() && resource.data.host == request.auth.uid;
    }
  }
}